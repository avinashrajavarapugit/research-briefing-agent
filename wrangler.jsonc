{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "research-briefing-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/oauth/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "BriefingAgent",
        "name": "BriefingAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["BriefingAgent"],
      "tag": "v1"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SOURCE_CACHE",
      "id": "e1a0c46f1c644bc1b1928891389fda03"
    }
  ],
  "workflows": [
    {
      "name": "research-workflow",
      "binding": "RESEARCH_WORKFLOW",
      "class_name": "ResearchWorkflow"
    }
  ]
}
